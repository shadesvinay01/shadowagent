{
  "name": "shadowagent-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install": "npm install -w website --legacy-peer-deps",
    "build": "npm run build -w website",
    "dev:website": "npm run dev -w website",
    "dev:desktop": "npm run tauri dev -w desktop",
    "build:website": "npm run build -w website",
    "build:desktop": "npm run tauri build -w desktop"
  }
}
